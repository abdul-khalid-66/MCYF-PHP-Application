# MCYF — public/.htaccess

# Disable directory listing
Options -Indexes

# Protect .env / config style files if ever placed here
<FilesMatch "\.(env|sql|log|md)$">
  Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Default character set
AddDefaultCharset UTF-8

# ── Clean URLs: hide the .php extension ────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If someone requests a URL that still ends in .php, send them to the
  # clean (extensionless) version with a permanent redirect — so .php
  # never appears in the address bar, in bookmarks, or in search engines.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Internally rewrite clean URLs back to their real .php file so the
  # app keeps working exactly as before — this step is invisible to the
  # browser. Skips requests that are already real files/folders (css, js,
  # images, uploads, etc.) so static assets are served normally.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
